# Backend API Keys (Server-side only - add these to Vercel)
# DO NOT use VITE_ prefix - these should NOT be exposed to browser

# Groq API for AI enhancement
GROQ_API_KEY=your_groq_api_key_here

# News API Keys (Get free keys from these sources)

# The Guardian (BEST - 5000 requests/day)
# Sign up: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_key_here

# Currents API (600 requests/day)
# Sign up: https://currentsapi.services/en/register
CURRENTS_API_KEY=your_currents_key_here

# GNews (100 requests/day)
# Sign up: https://gnews.io/register
GNEWS_API_KEY=your_gnews_key_here

# NewsData.io (200 requests/day)
# Sign up: https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_key_here

# PubMed E-utilities API (Health news - 10 requests/sec with key)
# Sign up: https://www.ncbi.nlm.nih.gov/account/ (Free NCBI account)
PUBMED_API_KEY=your_pubmed_api_key_here

# Alternative: OpenRouter API (supports many free models)
# VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# Research & Academic Sources (Free Tiers)

# arXiv API (no key required, keep default unless using a mirror)
# Docs: https://info.arxiv.org/help/api/index.html
ARXIV_API_BASE=https://export.arxiv.org/api/query

# Semantic Scholar API (free key for higher limits)
# Docs: https://api.semanticscholar.org/api-docs/
# Without key: 100 requests / 5 minutes
# With key: 5,000 requests / 5 minutes
SEMANTIC_SCHOLAR_API_BASE=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=

# Hugging Face Daily Papers (no key required)
# Docs: https://huggingface.co/docs
HUGGING_FACE_PAPERS_API=https://huggingface.co/api/daily_papers
